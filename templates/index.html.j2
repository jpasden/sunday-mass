<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catholic Sunday Mass</title>
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --crimson: #8B0000;
      --gold:    #C9A84C;
      --text:    #1a1a1a;
      --muted:   #666;
      --border:  #d8cfc4;
      --bg:      #ffffff;
      --tab-bg:  #f7f4f0;
      --kids-bg: #fdfbf7;
    }

    body {
      font-family: Georgia, 'Times New Roman', serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.75;
    }

    /* ── Header ── */
    header {
      background: var(--crimson);
      color: #fff;
      padding: 2rem 1rem 1.6rem;
      text-align: center;
    }
    header h1 {
      font-family: 'Cinzel', Georgia, serif;
      font-size: clamp(1.44rem, 5.6vw, 2.64rem);
      font-weight: 400;
      letter-spacing: 0.04em;
    }
    header .date {
      margin-top: 0.5rem;
      font-family: Arial, sans-serif;
      font-size: 1.75rem;
      color: rgba(255,255,255,0.95);
      letter-spacing: 0.03em;
    }
    header .lit-name {
      margin-top: 0.35rem;
      font-family: Arial, sans-serif;
      font-size: 1.1rem;
      color: rgba(255,255,255,0.65);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .gold-rule {
      border: none;
      border-top: 2px solid var(--gold);
      width: 60px;
      margin: 0.9rem auto 0;
    }

    /* ── Tab nav ── */
    .top-nav {
      display: flex;
      border-bottom: 2px solid var(--crimson);
      background: var(--tab-bg);
    }
    .top-nav button {
      flex: 1;
      padding: 0.9rem 1rem;
      border: none;
      background: none;
      font-family: Arial, sans-serif;
      font-size: 0.85rem;
      font-weight: bold;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      cursor: pointer;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: color 0.15s, border-color 0.15s;
    }
    .top-nav button:hover  { color: var(--crimson); }
    .top-nav button.active {
      color: var(--crimson);
      border-bottom-color: var(--crimson);
      background: var(--bg);
    }

    .top-panel         { display: none; }
    .top-panel.active  { display: block; }

    /* ── Panel layout ── */
    .panel-inner {
      max-width: 1140px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    /* ── Section labels ── */
    .section-label {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 1.25rem;
      font-weight: 400;
      color: var(--crimson);
      letter-spacing: 0.04em;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--gold);
      margin-bottom: 1.75rem;
    }

    /* ── Column header row ── */
    .col-header-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 0.5rem;
    }
    .col-header {
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: bold;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      padding-bottom: 0.35rem;
      border-bottom: 1px solid var(--border);
    }
    .col-header-kids {
      padding-left: 1.75rem;
      border-left: 1px solid var(--border);
    }

    /* ── Reading block ── */
    .reading-block {
      margin-bottom: 2.5rem;
    }
    .reading-heading {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.9rem;
    }
    .reading-name {
      font-family: Georgia, serif;
      font-size: 1.1rem;
      font-weight: bold;
      color: var(--text);
    }
    .reading-citation {
      font-family: Arial, sans-serif;
      font-size: 0.9rem;
      color: var(--gold);
      font-weight: bold;
    }

    /* ── Paragraph grid ── */
    .para-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: 1rem;
      align-items: start;
    }
    .para-adult {
      padding-right: 1.75rem;
      font-size: 0.975rem;
      line-height: 1.85;
    }
    .para-kids {
      padding-left: 1.75rem;
      border-left: 1px solid var(--border);
      font-size: 0.975rem;
      line-height: 1.85;
      color: #2a2a2a;
      background: var(--kids-bg);
    }

    /* ── Notes section ── */
    .notes-section {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px solid var(--border);
    }
    .note-block {
      margin-bottom: 2rem;
    }
    .note-name {
      font-family: Arial, sans-serif;
      font-size: 0.8rem;
      font-weight: bold;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.6rem;
    }
    .note-pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .note-adult {
      padding-right: 1.75rem;
      font-size: 0.975rem;
      line-height: 1.85;
    }
    .note-kids {
      padding-left: 1.75rem;
      border-left: 1px solid var(--border);
      font-size: 0.975rem;
      line-height: 1.85;
      color: #2a2a2a;
      background: var(--kids-bg);
    }

    /* ── AI disclaimer ── */
    .ai-disclaimer {
      margin-top: 2.5rem;
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      color: #aaa;
      font-style: italic;
      text-align: center;
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      color: #aaa;
      padding: 1.5rem 1rem;
      border-top: 1px solid var(--border);
    }

    /* ── Print styles ── */
    @media print {
      /* Print only the currently active tab */
      .top-panel         { display: none !important; }
      .top-panel.active  { display: block !important; }

      /* Hide interactive chrome */
      .top-nav { display: none !important; }

      /* Keep column grids intact */
      .para-grid,
      .note-pair,
      .col-header-row { display: grid !important; }

      /* Avoid breaking a paragraph pair across pages */
      .para-adult, .para-kids,
      .note-adult,  .note-kids  { page-break-inside: avoid; }

      /* Simplify header for print */
      header {
        background: none !important;
        color: var(--text) !important;
        border-bottom: 2px solid var(--crimson);
        padding: 1rem 0 0.75rem;
      }
      header h1   { color: var(--crimson) !important; }
      header .date,
      header .lit-name { color: var(--text) !important; }

      /* Ensure kids background prints */
      .para-kids,
      .note-kids { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

      body { font-size: 10pt; }
      .panel-inner { padding: 1rem 0; max-width: none; }
    }
  </style>
</head>
<body>

<header>
  <h1>Catholic Sunday Mass</h1>
  {% if sunday_date %}<p class="date">{{ sunday_date }}</p>{% endif %}
  {% if liturgical_name %}<p class="lit-name">{{ liturgical_name }}</p>{% endif %}
  <hr class="gold-rule">
</header>

<nav class="top-nav">
  <button class="active" onclick="showTab('en', this)">Readings (English)</button>
  <button onclick="showTab('es', this)">Readings (Español)</button>
</nav>

{# ═══════════════════════════════════════════════════════ ENGLISH TAB ══ #}
<div class="top-panel active" id="top-en">
  <div class="panel-inner">

    <h2 class="section-label">Readings</h2>

    <div class="col-header-row">
      <div class="col-header">Adults</div>
      <div class="col-header col-header-kids">Kids (age 12)</div>
    </div>

    {% set reading_labels = {
      "first_reading":  "First Reading",
      "second_reading": "Second Reading",
      "gospel":         "Gospel"
    } %}

    {% for key, label in reading_labels.items() %}
    {% if readings_en[key] is defined %}
    <div class="reading-block">
      <div class="reading-heading">
        <h3 class="reading-name">{{ label }}</h3>
        <span class="reading-citation">{{ readings_en[key].citation }}</span>
      </div>
      <div class="para-grid">
        {% for pair in readings_en[key].pairs %}
        <p class="para-adult">{{ pair.adult }}</p>
        <p class="para-kids">{{ pair.kids }}</p>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}

    {# ── Notes ── #}
    {% if notes_en %}
    <div class="notes-section">
      <h2 class="section-label">Notes</h2>

      <div class="col-header-row">
        <div class="col-header">Adults</div>
        <div class="col-header col-header-kids">Kids (age 12)</div>
      </div>

      {% if notes_en.historical_context %}
      <div class="note-block">
        <h3 class="note-name">Historical Context</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_en.historical_context }}</p>
          <p class="note-kids">{{ notes_en_kids.historical_context if notes_en_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

      {% if notes_en.connections %}
      <div class="note-block">
        <h3 class="note-name">Connections</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_en.connections }}</p>
          <p class="note-kids">{{ notes_en_kids.connections if notes_en_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

      {% if notes_en.meaning_today %}
      <div class="note-block">
        <h3 class="note-name">What does this mean for us today?</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_en.meaning_today }}</p>
          <p class="note-kids">{{ notes_en_kids.meaning_today if notes_en_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

    </div>
    {% endif %}

    <p class="ai-disclaimer">Kids&#x2019; adaptations, translations, and notes provided by Claude. Mistakes are possible. (Sorry!)</p>

  </div>
</div>

{# ═══════════════════════════════════════════════════════ SPANISH TAB ══ #}
<div class="top-panel" id="top-es">
  <div class="panel-inner">

    {% if readings_es %}

    <h2 class="section-label">Lecturas</h2>

    <div class="col-header-row">
      <div class="col-header">Adultos</div>
      <div class="col-header col-header-kids">Niños (12 años)</div>
    </div>

    {% set reading_labels_es = {
      "first_reading":  "Primera Lectura",
      "second_reading": "Segunda Lectura",
      "gospel":         "Evangelio"
    } %}

    {% for key, label in reading_labels_es.items() %}
    {% if readings_es[key] is defined %}
    <div class="reading-block">
      <div class="reading-heading">
        <h3 class="reading-name">{{ label }}</h3>
        <span class="reading-citation">{{ readings_es[key].citation }}</span>
      </div>
      <div class="para-grid">
        {% for pair in readings_es[key].pairs %}
        <p class="para-adult">{{ pair.adult }}</p>
        <p class="para-kids">{{ pair.kids }}</p>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}

    {# ── Notas ── #}
    {% if notes_es %}
    <div class="notes-section">
      <h2 class="section-label">Notas</h2>

      <div class="col-header-row">
        <div class="col-header">Adultos</div>
        <div class="col-header col-header-kids">Niños (12 años)</div>
      </div>

      {% if notes_es.historical_context %}
      <div class="note-block">
        <h3 class="note-name">Contexto Histórico</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_es.historical_context }}</p>
          <p class="note-kids">{{ notes_es_kids.historical_context if notes_es_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

      {% if notes_es.connections %}
      <div class="note-block">
        <h3 class="note-name">Conexiones</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_es.connections }}</p>
          <p class="note-kids">{{ notes_es_kids.connections if notes_es_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

      {% if notes_es.meaning_today %}
      <div class="note-block">
        <h3 class="note-name">¿Qué significa esto para nosotros hoy?</h3>
        <div class="note-pair">
          <p class="note-adult">{{ notes_es.meaning_today }}</p>
          <p class="note-kids">{{ notes_es_kids.meaning_today if notes_es_kids else '' }}</p>
        </div>
      </div>
      {% endif %}

    </div>
    {% endif %}

    {% else %}
    <p style="font-family:Arial,sans-serif; color:var(--muted); padding:2rem 0; font-style:italic;">
      Las lecturas en español no están disponibles en este momento.
    </p>
    {% endif %}

    <p class="ai-disclaimer">Las adaptaciones para niños, traducciones y notas son de Claude. Pueden contener errores. (¡Disculpen!)</p>

  </div>
</div>

<footer>
  Updated {{ last_updated }} UTC &nbsp;·&nbsp;
  English readings: Catholic Online &nbsp;·&nbsp;
  Spanish readings: USCCB &nbsp;·&nbsp;
  Notes adapted with Claude AI
</footer>

<script>
function showTab(id, btn) {
  document.querySelectorAll('.top-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.top-nav button').forEach(b => b.classList.remove('active'));
  document.getElementById('top-' + id).classList.add('active');
  btn.classList.add('active');
}
</script>

</body>
</html>
