<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ liturgical_name }} — Sunday Mass</title>
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --crimson: #8B0000;
      --gold: #C9A84C;
      --text: #1a1a1a;
      --muted: #666;
      --border: #e0d6c8;
      --bg: #ffffff;
      --tab-bg: #f7f4f0;
    }

    body {
      font-family: Georgia, 'Times New Roman', serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }

    /* ── Header ── */
    header {
      background: var(--crimson);
      color: #fff;
      padding: 2rem 1rem 1.6rem;
      text-align: center;
    }
    header h1 {
      font-size: clamp(1.2rem, 5vw, 2.2rem);
      font-weight: normal;
      letter-spacing: 0.03em;
    }
    header .date {
      margin-top: 0.4rem;
      font-family: Arial, sans-serif;
      font-size: 0.9rem;
      color: rgba(255,255,255,0.8);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .gold-rule {
      border: none;
      border-top: 2px solid var(--gold);
      width: 60px;
      margin: 0.9rem auto 0;
    }

    /* ── Top-level tab nav ── */
    .top-nav {
      display: flex;
      border-bottom: 2px solid var(--crimson);
      background: var(--tab-bg);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .top-nav button {
      flex: 1;
      min-width: 70px;
      padding: 0.85rem 0.5rem;
      border: none;
      background: none;
      font-family: Arial, sans-serif;
      font-size: 0.78rem;
      font-weight: bold;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
      cursor: pointer;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      white-space: nowrap;
      transition: color 0.15s, border-color 0.15s;
    }
    .top-nav button:hover { color: var(--crimson); }
    .top-nav button.active {
      color: var(--crimson);
      border-bottom-color: var(--crimson);
      background: var(--bg);
    }

    /* ── Top-level tab panels ── */
    .top-panel { display: none; }
    .top-panel.active { display: block; }

    /* ── Main content area ── */
    .panel-inner {
      max-width: 800px;
      margin: 0 auto;
      padding: 1.8rem 1rem 3.5rem;
    }

    /* ── Section label ── */
    .section-label {
      font-family: Arial, sans-serif;
      font-size: 0.68rem;
      font-weight: bold;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--crimson);
      margin-bottom: 1.2rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── Readings: stacked ── */
    .reading-block {
      margin-bottom: 2.5rem;
    }
    .reading-block:last-of-type {
      margin-bottom: 0;
    }
    .reading-name {
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: bold;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.3rem;
    }
    .reading-citation {
      font-family: Arial, sans-serif;
      font-size: 0.88rem;
      color: var(--gold);
      font-weight: bold;
      margin-bottom: 0.9rem;
    }
    .reading-text {
      font-size: 1rem;
      line-height: 1.9;
      color: var(--text);
      white-space: pre-wrap;
    }

    /* ── Video grid ── */
    .video-section { margin-top: 2.5rem; }

    .video-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    @media (min-width: 600px) {
      .video-grid {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      }
    }

    .video-embed {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 2px;
    }
    .video-embed iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: none;
    }
    .video-meta { margin-top: 0.6rem; }
    .video-title {
      font-family: Arial, sans-serif;
      font-size: 0.85rem;
      color: var(--text);
      line-height: 1.4;
    }
    .video-channel {
      font-family: Arial, sans-serif;
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.2rem;
    }

    .no-videos {
      font-family: Arial, sans-serif;
      font-size: 0.85rem;
      color: var(--muted);
      font-style: italic;
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      color: #aaa;
      padding: 1.5rem 1rem;
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>

<header>
  <h1>{{ liturgical_name }}</h1>
  {% if sunday_date %}
  <p class="date">{{ sunday_date }}</p>
  {% endif %}
  <hr class="gold-rule">
</header>

<nav class="top-nav">
  <button class="active" onclick="showTop('readings', this)">Readings</button>
  <button onclick="showTop('masses', this)">Masses</button>
  <button onclick="showTop('sermons', this)">Sermons</button>
  <button onclick="showTop('music', this)">Music</button>
</nav>

<!-- ══ READINGS TAB ══ -->
<div class="top-panel active" id="top-readings">
  <div class="panel-inner">

    <h2 class="section-label">Mass Readings</h2>

    {% if readings.first_reading %}
    <div class="reading-block">
      <p class="reading-name">First Reading</p>
      <p class="reading-citation">{{ readings.first_reading.citation }}</p>
      <div class="reading-text">{{ readings.first_reading.text }}</div>
    </div>
    {% endif %}

    {% if readings.psalm %}
    <div class="reading-block">
      <p class="reading-name">Responsorial Psalm</p>
      <p class="reading-citation">{{ readings.psalm.citation }}</p>
      <div class="reading-text">{{ readings.psalm.text }}</div>
    </div>
    {% endif %}

    {% if readings.second_reading %}
    <div class="reading-block">
      <p class="reading-name">Second Reading</p>
      <p class="reading-citation">{{ readings.second_reading.citation }}</p>
      <div class="reading-text">{{ readings.second_reading.text }}</div>
    </div>
    {% endif %}

    {% if readings.gospel %}
    <div class="reading-block">
      <p class="reading-name">Gospel</p>
      <p class="reading-citation">{{ readings.gospel.citation }}</p>
      <div class="reading-text">{{ readings.gospel.text }}</div>
    </div>
    {% endif %}

    {% if videos.readings %}
    <div class="video-section">
      <h2 class="section-label">Videos</h2>
      <div class="video-grid">
        {% for v in videos.readings %}
        <div class="video-card">
          <div class="video-embed">
            <iframe src="https://www.youtube.com/embed/{{ v.id }}"
              title="{{ v.title | e }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen loading="lazy"></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">{{ v.title }}</p>
            <p class="video-channel">{{ v.channel }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

  </div>
</div>

<!-- ══ MASSES TAB ══ -->
<div class="top-panel" id="top-masses">
  <div class="panel-inner">
    <h2 class="section-label">Full Masses</h2>
    {% if videos.full_mass %}
    <div class="video-grid">
      {% for v in videos.full_mass %}
      <div class="video-card">
        <div class="video-embed">
          <iframe src="https://www.youtube.com/embed/{{ v.id }}"
            title="{{ v.title | e }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="video-meta">
          <p class="video-title">{{ v.title }}</p>
          <p class="video-channel">{{ v.channel }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-videos">No videos found yet.</p>
    {% endif %}
  </div>
</div>

<!-- ══ SERMONS TAB ══ -->
<div class="top-panel" id="top-sermons">
  <div class="panel-inner">
    <h2 class="section-label">Homilies &amp; Sermons</h2>
    {% if videos.homily %}
    <div class="video-grid">
      {% for v in videos.homily %}
      <div class="video-card">
        <div class="video-embed">
          <iframe src="https://www.youtube.com/embed/{{ v.id }}"
            title="{{ v.title | e }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="video-meta">
          <p class="video-title">{{ v.title }}</p>
          <p class="video-channel">{{ v.channel }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-videos">No videos found yet.</p>
    {% endif %}
  </div>
</div>

<!-- ══ MUSIC TAB ══ -->
<div class="top-panel" id="top-music">
  <div class="panel-inner">
    <h2 class="section-label">Music</h2>
    {% if videos.music %}
    <div class="video-grid">
      {% for v in videos.music %}
      <div class="video-card">
        <div class="video-embed">
          <iframe src="https://www.youtube.com/embed/{{ v.id }}"
            title="{{ v.title | e }}"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen loading="lazy"></iframe>
        </div>
        <div class="video-meta">
          <p class="video-title">{{ v.title }}</p>
          <p class="video-channel">{{ v.channel }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="no-videos">No videos found yet.</p>
    {% endif %}
  </div>
</div>

<footer>
  Updated {{ last_updated }} UTC &nbsp;|&nbsp; Readings from Catholic Online
</footer>

<script>
function showTop(id, btn) {
  document.querySelectorAll('.top-panel').forEach(function(p) {
    p.classList.remove('active');
  });
  document.querySelectorAll('.top-nav button').forEach(function(b) {
    b.classList.remove('active');
  });
  document.getElementById('top-' + id).classList.add('active');
  btn.classList.add('active');
}
</script>

</body>
</html>
