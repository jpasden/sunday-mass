<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ liturgical_name }} — Sunday Mass</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --crimson: #8B0000;
      --gold: #C9A84C;
      --text: #1a1a1a;
      --muted: #555;
      --border: #e0d6c8;
      --bg: #ffffff;
    }

    body {
      font-family: Georgia, 'Times New Roman', serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }

    a { color: var(--crimson); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Header ── */
    header {
      background: var(--crimson);
      color: #fff;
      padding: 2.5rem 1.5rem 2rem;
      text-align: center;
    }
    header h1 {
      font-size: clamp(1.4rem, 4vw, 2.2rem);
      font-weight: normal;
      letter-spacing: 0.03em;
    }
    header .date {
      margin-top: 0.4rem;
      font-family: Arial, sans-serif;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.8);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .gold-rule {
      border: none;
      border-top: 2px solid var(--gold);
      width: 80px;
      margin: 1rem auto 0;
    }

    /* ── Main layout ── */
    main {
      max-width: 860px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }

    /* ── Section headings ── */
    .section-title {
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: bold;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--crimson);
      margin-bottom: 1.2rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── Readings ── */
    .readings { margin-bottom: 3rem; }

    .reading-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.5rem;
    }
    .tab-btn {
      background: none;
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 0.35rem 0.9rem;
      font-family: Arial, sans-serif;
      font-size: 0.8rem;
      cursor: pointer;
      color: var(--muted);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .tab-btn:hover { border-color: var(--crimson); color: var(--crimson); }
    .tab-btn.active {
      background: var(--crimson);
      border-color: var(--crimson);
      color: #fff;
    }

    .reading-panel { display: none; }
    .reading-panel.active { display: block; }

    .reading-citation {
      font-family: Arial, sans-serif;
      font-size: 0.82rem;
      color: var(--gold);
      font-weight: bold;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .reading-text {
      font-size: 1rem;
      line-height: 1.85;
      color: var(--text);
      white-space: pre-wrap;
    }

    /* ── Videos ── */
    .videos { margin-bottom: 2rem; }

    .video-category { margin-bottom: 2.5rem; }
    .video-category-title {
      font-family: Arial, sans-serif;
      font-size: 0.78rem;
      font-weight: bold;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .video-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.2rem;
    }

    .video-card {}
    .video-embed {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .video-embed iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: none;
    }
    .video-meta {
      margin-top: 0.5rem;
    }
    .video-title {
      font-family: Arial, sans-serif;
      font-size: 0.82rem;
      color: var(--text);
      line-height: 1.4;
    }
    .video-channel {
      font-family: Arial, sans-serif;
      font-size: 0.73rem;
      color: var(--muted);
      margin-top: 0.2rem;
    }

    .no-videos {
      font-family: Arial, sans-serif;
      font-size: 0.85rem;
      color: var(--muted);
      font-style: italic;
    }

    /* ── Footer ── */
    footer {
      text-align: center;
      font-family: Arial, sans-serif;
      font-size: 0.72rem;
      color: #aaa;
      padding: 1.5rem;
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>

<header>
  <h1>{{ liturgical_name }}</h1>
  {% if sunday_date %}
  <p class="date">{{ sunday_date }}</p>
  {% endif %}
  <hr class="gold-rule">
</header>

<main>

  <!-- READINGS -->
  <section class="readings">
    <h2 class="section-title">Mass Readings</h2>

    <div class="reading-tabs">
      {% if readings.first_reading %}
      <button class="tab-btn active" onclick="showTab('first_reading', this)">First Reading</button>
      {% endif %}
      {% if readings.psalm %}
      <button class="tab-btn" onclick="showTab('psalm', this)">Psalm</button>
      {% endif %}
      {% if readings.second_reading %}
      <button class="tab-btn" onclick="showTab('second_reading', this)">Second Reading</button>
      {% endif %}
      {% if readings.gospel %}
      <button class="tab-btn" onclick="showTab('gospel', this)">Gospel</button>
      {% endif %}
    </div>

    {% if readings.first_reading %}
    <div class="reading-panel active" id="panel-first_reading">
      <p class="reading-citation">{{ readings.first_reading.citation }}</p>
      <div class="reading-text">{{ readings.first_reading.text }}</div>
    </div>
    {% endif %}

    {% if readings.psalm %}
    <div class="reading-panel" id="panel-psalm">
      <p class="reading-citation">{{ readings.psalm.citation }}</p>
      <div class="reading-text">{{ readings.psalm.text }}</div>
    </div>
    {% endif %}

    {% if readings.second_reading %}
    <div class="reading-panel" id="panel-second_reading">
      <p class="reading-citation">{{ readings.second_reading.citation }}</p>
      <div class="reading-text">{{ readings.second_reading.text }}</div>
    </div>
    {% endif %}

    {% if readings.gospel %}
    <div class="reading-panel" id="panel-gospel">
      <p class="reading-citation">{{ readings.gospel.citation }}</p>
      <div class="reading-text">{{ readings.gospel.text }}</div>
    </div>
    {% endif %}
  </section>

  <!-- VIDEOS -->
  <section class="videos">
    <h2 class="section-title">Videos</h2>

    <!-- Full Masses -->
    <div class="video-category">
      <p class="video-category-title">Full Masses</p>
      {% if videos.full_mass %}
      <div class="video-row">
        {% for v in videos.full_mass %}
        <div class="video-card">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/{{ v.id }}"
              title="{{ v.title | e }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">{{ v.title }}</p>
            <p class="video-channel">{{ v.channel }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-videos">No videos found yet.</p>
      {% endif %}
    </div>

    <!-- Homilies -->
    <div class="video-category">
      <p class="video-category-title">Homilies &amp; Sermons</p>
      {% if videos.homily %}
      <div class="video-row">
        {% for v in videos.homily %}
        <div class="video-card">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/{{ v.id }}"
              title="{{ v.title | e }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">{{ v.title }}</p>
            <p class="video-channel">{{ v.channel }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-videos">No videos found yet.</p>
      {% endif %}
    </div>

    <!-- Music -->
    <div class="video-category">
      <p class="video-category-title">Music</p>
      {% if videos.music %}
      <div class="video-row">
        {% for v in videos.music %}
        <div class="video-card">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/{{ v.id }}"
              title="{{ v.title | e }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">{{ v.title }}</p>
            <p class="video-channel">{{ v.channel }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-videos">No videos found yet.</p>
      {% endif %}
    </div>

  </section>

</main>

<footer>
  Updated {{ last_updated }} UTC &nbsp;|&nbsp; Readings from Catholic Online
</footer>

<script>
function showTab(id, btn) {
  document.querySelectorAll('.reading-panel').forEach(function(p) {
    p.classList.remove('active');
  });
  document.querySelectorAll('.tab-btn').forEach(function(b) {
    b.classList.remove('active');
  });
  document.getElementById('panel-' + id).classList.add('active');
  btn.classList.add('active');
}
</script>

</body>
</html>
